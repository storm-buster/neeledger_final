# ==============================================================================
# NeeLedger Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Presentation & Demo Mode (Hackathon Evaluation)
# ------------------------------------------------------------------------------
# When enabled in local development (DEV), allows instant preview of both
# User Panel (Project Proponent) and Admin Panel (MRV Auditor) with realistic
# mock carbon data without requiring an active Supabase connection or backend services.
#
# NOTE: Demo mode is strictly disabled in production builds (import.meta.env.PROD).
VITE_ENABLE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. Live Supabase Authentication & Database (Optional for Demo Mode)
# ------------------------------------------------------------------------------
# In live production/staging mode, credentials must be provided for your Supabase project.
# In local demo mode, these are not called or required.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 3. Microservice Endpoints (Optional for Demo Mode)
# ------------------------------------------------------------------------------
# Node.js Express server (port 4000) for satellite, XAI proxy, and geocoding:
VITE_API_BASE_URL=http://localhost:4000
# Legacy alias support:
VITE_API_URL=http://localhost:4000

# Python FastAPI XGBoost biomass prediction service (port 8001):
VITE_BIOMASS_API_URL=http://localhost:8001/predict-biomass

# ------------------------------------------------------------------------------
# 4. Storage & AI Providers (Optional for Demo Mode)
# ------------------------------------------------------------------------------
# Pinata IPFS credentials for document pinning:
VITE_PINATA_JWT=your_pinata_jwt_here
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# Gemini AI service API Key:
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Groq/Grok API Key (used by Express backend for PDF comparison):
GROQ_API_KEY=your_groq_api_key_here
